{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas Setup",
  "version": "0.1.4",
  "identifier": "me.willhenry.atlas.setup",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../../dist-setup"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "url": "setup.html",
        "title": "Atlas Setup",
        "width": 600,
        "height": 420,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../app/icons/icon.ico"]
  }
}
